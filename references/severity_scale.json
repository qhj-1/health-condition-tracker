{
  "version": "1.1",
  "说明": "难受程度 1-10 客观化评估标准：不再只问一个数字，而是分维度询问后加权计算，避免主观偏差。",
  "verbal_scale": [
    {
      "score": 0,
      "label": "无症状"
    },
    {
