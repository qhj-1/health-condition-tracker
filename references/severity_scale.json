  "dimensions": {
    "疼痛不适强度": {
      "question": "最近最明显时，不适有多强？（0-10）",
      "type": "0-10",
      "weight": 0.3
    },
    "睡眠影响": {
      "question": "这个不适是否影响睡眠？",
      "type": "choice",
      "weight": 0.15,
      "options": {
        "完全不影响": 0,
        "偶尔醒来": 1,
        "每晚醒2次以上": 2,
        "基本睡不好": 3
      }
    },
    "工作学习影响": {
      "question": "是否影响工作或学习？",
      "type": "choice",
      "weight": 0.15,
      "options": {
        "完全不影响": 0,
        "效率略降": 1,
        "需要请假或停课半天以上": 2,
        "完全无法进行": 3
      }
    },
    "饮食影响": {
      "question": "是否影响进食？",
      "type": "choice",
      "weight": 0.1,
      "options": {
        "不影响": 0,
        "食欲略降": 1,
        "明显减少": 2,
        "基本吃不下": 3
      }
    },
    "活动影响": {
      "question": "是否影响日常活动（走路/家务/上下楼）？",
      "type": "choice",
      "weight": 0.15,
      "options": {
        "不影响": 0,
        "略受限": 1,
        "明显受限": 2,
        "无法下床或出门": 3
      }
    },
    "发作频率": {
      "question": "最近发作频率？",
      "type": "choice",
      "weight": 0.1,
      "options": {
        "偶尔（每周1次以内）": 0,
        "每周几次": 1,
        "每天1次左右": 2,
        "每天多次或持续不断": 3
      }
    },
    "时间趋势": {
      "question": "和之前比，现在怎么样？",
      "type": "choice",
      "weight": 0.05,
      "options": {
        "好转": -1,
        "平稳": 0,
        "略加重": 1,
        "明显加重": 2,
        "快速恶化": 3
      }
    }
  },
  "formula": "综合分 = 强度分×0.30 + Σ(维度分÷3×10×权重)；权重合计=1，理论最大10分",
  "levels": [
    {
      "min": 0,
      "max": 2.9,
      "name": "轻微",
      "action": "以观察为主；如持续超过1-2周再就诊。"
    },
    {
      "min": 3,
      "max": 4.9,
      "name": "轻度",
      "action": "建议预约门诊检查，明确原因。"
    },
    {
      "min": 5,
      "max": 6.9,
      "name": "中度",
      "action": "建议近期（1-7天内）尽早就诊。"
    },
    {
      "min": 7,
      "max": 8.9,
      "name": "重度",
      "action": "建议尽快（1-2天内）就诊，避免拖延。"
    },
    {
      "min": 9,
      "max": 10,
      "name": "极重度",
      "action": "建议立即就医评估，必要时急诊。"
    }
  ],
  "red_flags": [
    "呼吸困难或气促",
    "胸痛或胸闷",
    "意识模糊或昏厥",
    "严重出血",
    "剧烈到无法忍受"
  ]
}